{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "outDir": "./dist-ts",
    "paths": {
      "@tgdf": ["src/lib/index.ts"],
      "@tgdf/*": ["src/lib/*"],
      "renderer/*": ["src/renderer/*"],
      "3D/*": ["src/renderer/3D/*"],
      "UI": ["src/renderer/UI/index.ts"],
      "UI/*": ["src/renderer/UI/*"],
      "Views": ["src/renderer/Views/index.ts"],
      "Views/*": ["src/renderer/Views/*"],
      "Store/*": ["src/renderer/Store/*"],
      "WorldEditor/*": ["src/renderer/WorldEditor/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "release", "dist-ts"]
}
