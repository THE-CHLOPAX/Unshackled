{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "jsx": "react-jsx",
    "paths": {
      "@tgdf": ["src/lib/index.ts"],
      "@tgdf/*": ["src/lib/*"],
      "renderer/*": ["src/renderer/*"],
      "3D/*": ["src/renderer/3D/*"],
      "UI": ["src/renderer/UI/index.ts"],
      "UI/*": ["src/renderer/UI/*"],
      "Views": ["src/renderer/Views/index.ts"],
      "Views/*": ["src/renderer/Views/*"],
      "Store/*": ["src/renderer/Store/*"],
      "WorldEditor/*": ["src/renderer/WorldEditor/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/global.d.ts"],
  "exclude": ["src/main/**/*", "node_modules"]
}
